direction: right

# ─── Tank Component Classes ────────────────────────────────────

TankRoot: {
  Tank: {
    shape: class
    hull: HullMovement
    turret: TurretMovement
    shooter: Shooter
    health: Health
    input_reader: "InputReader (Node)"
    max_health: float
    find_in(node): "static Tank"
    get_player_id(): int
    take_damage(amount)
    despawn()
  }

  HullMovement: {
    shape: class
    "« RigidBody2D »"
    profile: HullMovementProfile
    input: "InputReader"
    "ArmorPlate ×N"
    "SyncTransform (Node2D)"
    "PositionTracker (Node2D)"
    "FollowPlayer (Camera2D)"
    _integrate_forces(state)
  }

  TurretMovement: {
    shape: class
    "« Node2D »"
    profile: TurretMovementProfile
    input: "InputReader"
    "SyncTransform (Node2D)"
    _angular_velocity: float
    _physics_process(delta)
  }

  Shooter: {
    shape: class
    "« Node2D »"
    profile: ShooterProfile
    input: "InputReader"
    muzzle: "Marker2D"
    manager: ProjectileManager
    _is_reloading: bool
    _fire()
    reload()
    sync_reload(time)
  }

  Health: {
    shape: class
    "« Node »"
    max_health: float
    current_health: float
    take_damage(amount)
    heal(amount)
    damaged(signal)
    died(signal)
  }

  ArmorPlate: {
    shape: class
    "« CollisionShape2D »"
    thickness: float
    apply_damage(amount)
  }

  PositionTracker: {
    shape: class
    "« Node2D »"
    body: Node2D
    max_history: int
    get_position_at(time): Vector2
  }

  MovementHelper: {
    shape: class
    "static utility"
    get_accel(input, cur, accel, friction, fn): float
  }

  TankEntry: {
    shape: class
    "« Resource »"
    display_name: String
    tank_scene: PackedScene
    miniature: PackedScene
  }
}

# ─── Data Profiles ─────────────────────────────────────────────

Profiles: {
  HullMovementProfile: {
    shape: class
    "« Resource »"
    speed: float
    reverse_speed: float
    acceleration: float
    friction: float
    turn_speed: float
    turn_acceleration: float
    turn_friction: float
  }

  TurretMovementProfile: {
    shape: class
    "« Resource »"
    speed: float
    acceleration: float
    friction: float
    use_angles: bool
    max_angle_left: float
    max_angle_right: float
  }

  ShooterProfile: {
    shape: class
    "« Resource »"
    reload_time: float
    projectile_scene: PackedScene
  }
}

# ─── Composition (has-a) ───────────────────────────────────────

TankRoot.Tank -> TankRoot.HullMovement: hull
TankRoot.Tank -> TankRoot.TurretMovement: turret
TankRoot.Tank -> TankRoot.Shooter: shooter
TankRoot.Tank -> TankRoot.Health: health
TankRoot.HullMovement -> TankRoot.ArmorPlate: armor plates
TankRoot.HullMovement -> TankRoot.PositionTracker: tracks

# ─── Profile Usage ─────────────────────────────────────────────

TankRoot.HullMovement -> Profiles.HullMovementProfile: profile
TankRoot.TurretMovement -> Profiles.TurretMovementProfile: profile
TankRoot.Shooter -> Profiles.ShooterProfile: profile

# ─── Utility Usage ─────────────────────────────────────────────

TankRoot.HullMovement -> TankRoot.MovementHelper: uses
TankRoot.TurretMovement -> TankRoot.MovementHelper: uses
