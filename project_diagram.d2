direction: down

# Global & Networking
Network: {
  MultiplayerInit: {
    shape: class
    _start_server()
    connect_to_server(ip, port)
  }

  NetConfig: {
    shape: class
    TICK_RATE: float
    IP_ADDRESS: string
    PORT: int
  }

  TankSpawner: {
    shape: class
    tank_entries: "Array[TankEntry]"
    _player_tanks: Dictionary
    setup()
    _spawn_tank(data)
    _on_spawn_requested(peer_id, index)
  }

  SyncTransform: {
    shape: class
    body: Node2D
    target_pos: Vector2
    target_rot: float
    sync_transform(pos, rot)
  }

  NetworkBus: {
    shape: class
    spawn_requested(id, index): signal
    spawned(id, path): signal
  }

  LocalBus: {
    shape: class
    health_updated(id, current, max): signal
    reload_started(id, time): signal
  }
}

# Tank System
TankSystem: {
  Tank: {
    shape: class
    hull: HullMovement
    turret: TurretMovement
    shooter: Shooter
    health: Health
    input_reader: InputReader
    take_damage(amount)
    despawn()
  }

  HullMovement: {
    shape: class
    profile: HullMovementProfile
    input: InputReader
    _integrate_forces(state)
  }

  TurretMovement: {
    shape: class
    profile: TurretMovementProfile
    input: InputReader
  }

  Shooter: {
    shape: class
    profile: ShooterProfile
    muzzle: Marker2D
    _fire()
    reload()
  }

  Health: {
    shape: class
    max_health: float
    current_health: float
    damaged(amt, new): signal
    died(): signal
    take_damage(amount)
    heal(amount)
  }

  InputReader: {
    shape: class
    move: Vector2i
    mouse: Vector2
    shooting: bool
    send_input(move, mouse, shooting)
  }
}

# Projectile System
ProjectileSystem: {
  Projectile: {
    shape: class
    owner_id: int
    profile: ProjectileProfile
    setup(pos, angle, owner)
    despawn()
  }

  ProjectileManager: {
    shape: class
    projectile_scene: PackedScene
    spawn(data)
  }

  HitResolver: {
    shape: class
    resolve(body, shape_idx, world, velocity, profile, \.\.\.)
  }
}

# Profiles & Resources
Profiles: {
  HullMovementProfile: {shape: class; speed: float; turn_speed: float}
  TurretMovementProfile: {shape: class; speed: float; use_angles: bool}
  ShooterProfile: {shape: class; reload_time: float}
  ProjectileProfile: {shape: class; damage: float; penetration: float}
}

# Relationships
TankSystem.Tank -> TankSystem.HullMovement: contains
TankSystem.Tank -> TankSystem.TurretMovement: contains
TankSystem.Tank -> TankSystem.Shooter: contains
TankSystem.Tank -> TankSystem.Health: contains
TankSystem.Tank -> TankSystem.InputReader: contains

TankSystem.HullMovement -> Profiles.HullMovementProfile: uses
TankSystem.TurretMovement -> Profiles.TurretMovementProfile: uses
TankSystem.Shooter -> Profiles.ShooterProfile: uses
ProjectileSystem.Projectile -> Profiles.ProjectileProfile: uses

TankSystem.HullMovement -> TankSystem.InputReader: reads
TankSystem.TurretMovement -> TankSystem.InputReader: reads
TankSystem.Shooter -> TankSystem.InputReader: reads

Network.TankSpawner -> TankSystem.Tank: spawns
ProjectileSystem.ProjectileManager -> ProjectileSystem.Projectile: spawns
TankSystem.Shooter -> ProjectileSystem.ProjectileManager: requests spawn

ProjectileSystem.Projectile -> ProjectileSystem.HitResolver: uses to resolve
ProjectileSystem.HitResolver -> TankSystem.Health: applies damage
ProjectileSystem.HitResolver -> TankSystem.Tank: applies damage (via fallback)

Network.SyncTransform -> TankSystem.HullMovement: syncs (parent)

# Inheritance from Godot Classes
TankSystem.HullMovement -> RigidBody2D: extends
TankSystem.TurretMovement -> Node2D: extends
TankSystem.Tank -> Node2D: extends
ProjectileSystem.Projectile -> Area2D: extends
Network.TankSpawner -> MultiplayerSpawner: extends
ProjectileSystem.ProjectileManager -> MultiplayerSpawner: extends
TankSystem.InputReader -> Node: extends
TankSystem.Health -> Node: extends
Profiles.HullMovementProfile -> Resource: extends
Profiles.TurretMovementProfile -> Resource: extends
Profiles.ShooterProfile -> Resource: extends
Profiles.ProjectileProfile -> Resource: extends
